Program
  ImmutableDecl 🟢 speed_limit
    Integer 90
  MutableDecl 🟢 current_speed
    Integer 120
  MutableDecl 🚦 speeding
    Boolean false
  MutableDecl 🚦 warning
    Boolean false
  If
    Condition
      Comparison ≠
        Identifier current_speed
        Identifier speed_limit
    Then
      Assignment speeding
        Boolean true
      If
        Condition
          Comparison ≡
            Identifier speeding
            Boolean true
        Then
          Assignment warning
            Boolean true
        Else
          Assignment warning
            Boolean false
    Else
      Assignment speeding
        Boolean false
      Assignment warning
        Boolean false
