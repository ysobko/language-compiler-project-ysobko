Program
  ConstantDecl 🛣️ ROUTE_DISTANCE
    Integer 7500000000
  ImmutableDecl 🟢 speed_limit
    Integer 90
  MutableDecl 🟢 current_speed
    Integer 110
  MutableDecl 🚦 route_open
    Boolean true
  If
    Condition
      Comparison ≠
        Identifier current_speed
        Identifier speed_limit
    Then
      ImmutableDecl 🟢 safe_speed
        Identifier speed_limit
      MutableDecl 🚦 warning
