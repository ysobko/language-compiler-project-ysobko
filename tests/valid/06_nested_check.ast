Program
  ImmutableDecl 🟢 speed_limit
    Integer 90
  MutableDecl 🟢 current_speed
    Integer 120
  MutableDecl 🚦 speeding
    Boolean false
  MutableDecl 🚦 stopped
    Boolean false
  If
    Condition
      Comparison ≠
        Identifier current_speed
        Identifier speed_limit
    Then
      Assignment speeding
        Boolean true
      If
        Condition
          Comparison ≡
            Identifier speeding
            Boolean true
        Then
          Assignment current_speed
            Identifier speed_limit
          Assignment stopped
            Boolean false
